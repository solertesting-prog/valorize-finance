NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

DATABASE_URL=postgresql://valorize:valorize@localhost:5432/valorize?schema=public
REDIS_URL=redis://127.0.0.1:6379

# Secretos: genera cada uno con `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30
QR_SIGNING_SECRET=change-me-qr-secret-at-least-32-chars
# 32 bytes en base64: `openssl rand -base64 32`
FIELD_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Correo (SMTP). En desarrollo, Mailpit en localhost:1025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Valorize Finance <no-reply@valorize.finance>"

# SMS: "console" (desarrollo) o "twilio"
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Push (Expo). Opcional: token de acceso para Expo Push con seguridad reforzada
EXPO_ACCESS_TOKEN=

# Almacenamiento S3 (MinIO en desarrollo)
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=eu-west-1
S3_BUCKET=valorize-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Rate limiting
RATE_LIMIT_TTL_SEC=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# Reglas de negocio
CANCEL_CUTOFF_MIN=60
MAX_RESCHEDULES=3
MAX_ACTIVE_BOOKINGS_PER_USER=3
NO_SHOW_GRACE_MIN=15
CHECKIN_EARLY_MIN=60
REMINDER_HOURS_BEFORE=24

# Auditoría de wallets (opcional; sin claves se usan RPC públicos y TronGrid sin clave)
RPC_ETHEREUM_URL=
RPC_POLYGON_URL=
RPC_BSC_URL=
TRONGRID_API_KEY=
# Etherscan v2 (una clave para Ethereum, Polygon y BNB Chain): antigüedad de la wallet
ETHERSCAN_API_KEY=
# API gratuita de sanciones de Chainalysis
CHAINALYSIS_SANCTIONS_API_KEY=
SCREENING_OFFLINE=false
# Explorador OpenScan para revisar wallets y transacciones (puedes usar una instancia propia)
OPENSCAN_URL=https://openscan.eth.link/
